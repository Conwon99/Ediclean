---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../sections/Navbar';
import { QuoteSection } from '../sections/QuoteSection';
import { ContactPageSupplement } from '../sections/ContactPage';
import { FooterSection } from '../sections/FooterSection';
import { BUSINESS_NAME, PHONE_DISPLAY, SITE_URL, GBP_PRIMARY_CATEGORY_LABEL, SERVICE_REGION_SHORT, SITE_TITLE_AREA } from '../constants/site';

const title = `Contact ${BUSINESS_NAME} | ${GBP_PRIMARY_CATEGORY_LABEL} ${SITE_TITLE_AREA}`;
const description = `Contact ${BUSINESS_NAME} for exterior cleaning in ${SERVICE_REGION_SHORT}. Call ${PHONE_DISPLAY} or use the form — roof, render, driveway, gutter, PVC and window cleaning. Fully insured.`;

const contactPageJsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: `Contact ${BUSINESS_NAME}`,
  description,
  url: `${SITE_URL}/contact/`,
  mainEntity: { "@id": `${SITE_URL}/#localbusiness` },
};
---

<Layout title={title} description={description} extraJsonLd={[contactPageJsonLd]}>
  <div class="min-h-screen bg-neutral-100 font-figtree text-black text-sm leading-5 antialiased">
    <Navbar client:load />
    <main class="pt-0">
      <h1 class="sr-only">Contact {BUSINESS_NAME}</h1>
      <QuoteSection client:load showTerms={false} />
      <ContactPageSupplement client:load />
      <FooterSection client:load />
    </main>
  </div>
</Layout>
